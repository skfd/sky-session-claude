<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Win32_Process.Create, for launches that must outlive the desktop app (OutsideJob). -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same reason SessionCli does it: a rule worth locking is not always a rule worth
         publishing. SessionUri.Under decides whether a link may open a session in a folder,
         which wants tests more than it wants callers. -->
    <InternalsVisibleTo Include="SessionCore.Tests" />
  </ItemGroup>

</Project>
