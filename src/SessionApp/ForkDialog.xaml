<Window x:Class="SessionApp.ForkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fork session"
        Width="680" Height="460" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.List.Background}"
        TextOptions.TextFormattingMode="Display">

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="Pick where the new session branches off. The original session is never modified."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Fork" Padding="14,5" Margin="0,0,8,0" IsDefault="True"
                    Click="Fork_Click"/>
            <Button Content="Cancel" Padding="14,5" IsCancel="True"/>
        </StackPanel>

        <ListBox x:Name="List" BorderThickness="1"
                 BorderBrush="{DynamicResource Brush.Bar.Border}"
                 Background="{DynamicResource Brush.List.Background}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="Fork_Click">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,5">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Title}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Margin="0,1,0,0" FontStyle="Italic"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Detail}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
