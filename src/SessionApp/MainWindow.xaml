<Window x:Class="SessionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SessionApp"
        Title="{Binding WindowTitle}"
        Icon="app.ico"
        Height="720" Width="1200" WindowStartupLocation="CenterScreen"
        FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.List.Background}"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Card row. Fixed height: long recaps are clipped, never stretch the row. -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Card.Separator}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Card.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Card.Selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer version link: quiet until hovered, then reads as a link. -->
        <Style x:Key="FooterLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Accent}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!--
            Status accent stripe down the card's left edge. Driven by triggers rather
            than a brush on the row so a theme swap repaints it: the palette brushes
            resolve dynamically, a brush handed over from code would not.
        -->
        <Style x:Key="StatusStripe" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent.None}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="waiting-you">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Amber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="waiting-agent">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Blue}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="cut-off">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Red}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="limit">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Purple}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="error">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Red}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="interrupted">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Orange}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter bar + actions, one row across the top. -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Bar.Border}"
                Background="{DynamicResource Brush.Bar.Background}">
            <DockPanel Margin="8,7">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Refresh (R)" Padding="12,5" Margin="0,0,6,0"
                            Command="{Binding RefreshCommand}"/>
                    <Button x:Name="CopyBtn" Content="Copy resume command(s)" Padding="12,5"
                            Click="CopyBtn_Click"/>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Search:" Style="{StaticResource BarLabel}"/>
                    <TextBox x:Name="SearchBox" Width="200" Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>

                    <ComboBox Width="140" Margin="0,0,6,0" VerticalAlignment="Center"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding StatusFilter}"/>
                    <ComboBox Width="172" Margin="0,0,10,0" VerticalAlignment="Center"
                              ItemsSource="{Binding ProjectOptions}"
                              SelectedItem="{Binding ProjectFilter}"/>

                    <CheckBox Content="Hide completed" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsChecked="{Binding HideCompleted}"/>
                    <CheckBox Content="Show abandoned" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsChecked="{Binding ShowAbandoned}"
                              ToolTip="Sessions you crossed out with X — still unfinished, just not coming back to"/>
                    <CheckBox Content="All projects" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsChecked="{Binding AllProjects}"/>
                    <CheckBox Content="Live" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsChecked="{Binding LiveUpdates}"
                              ToolTip="Auto-refresh when a session file changes"/>

                    <TextBlock Text="Show:" Style="{StaticResource BarLabel}"/>
                    <ComboBox Width="78" VerticalAlignment="Center"
                              ItemsSource="{Binding TopOptions}"
                              SelectedItem="{Binding TopSelection}"
                              ToolTip="Max sessions to load (older 1M sessions may need a larger cap)"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <ListBox x:Name="Grid" Grid.Row="1"
                 ItemsSource="{Binding RowsView}"
                 SelectionMode="Extended"
                 BorderThickness="0"
                 Background="{DynamicResource Brush.List.Background}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource CardItem}"
                 MouseDoubleClick="Grid_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="126">
                        <!-- Abandoned cards read as set aside: dimmed, with a struck-out title. -->
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Abandoned}" Value="True">
                                        <Setter Property="Opacity" Value="0.65"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status accent stripe; transparent for completed sessions. -->
                        <Rectangle Grid.Column="0" Style="{StaticResource StatusStripe}"/>

                        <Grid Grid.Column="1" Margin="10,7,10,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Title line: name on the left, project + age on the right. -->
                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Foreground="{DynamicResource Brush.Text.Secondary}">
                                    <Run Text="{Binding Project, Mode=OneWay}"
                                         Foreground="{DynamicResource Brush.Text.Emphasis}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding RelativeAge, Mode=OneWay}"
                                         ToolTip="{Binding Timestamp}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{DynamicResource Brush.Text.Title}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Abandoned}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Text="{Binding LastPrompt}" Margin="0,3,0,0"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LastPrompt}"/>

                            <!-- Two lines of recap, hard-clipped; hover for the rest. -->
                            <TextBlock Grid.Row="2" Text="{Binding Recap}" Margin="0,2,0,0"
                                       Height="40" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource Brush.Text.Primary}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="520">
                                        <TextBlock Text="{Binding Recap}" TextWrapping="Wrap" FontSize="14"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>

                            <TextBlock Grid.Row="3" Text="{Binding MetaLine}" Margin="0,2,0,0"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Bar.Border}"
                Background="{DynamicResource Brush.Bar.Background}">
            <DockPanel Margin="10,5">
                <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Hyperlink Style="{StaticResource FooterLink}" Click="Changelog_Click"
                               ToolTip="What changed in each version — opens the changelog on GitHub">
                        <Run Text="{x:Static local:MainViewModel.VersionLabel}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusLine}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
