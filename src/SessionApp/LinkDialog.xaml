<Window x:Class="SessionApp.LinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sky Session Claude"
        SizeToContent="Height" Width="440" MinHeight="140"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True"
        FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.List.Background}"
        TextOptions.TextFormattingMode="Display">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="Accept" Padding="14,5" Margin="0,0,8,0" IsDefault="True"
                    Click="Accept_Click"/>
            <Button x:Name="Reject" Padding="14,5" IsCancel="True"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="Headline" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Title}"/>
            <TextBlock x:Name="Detail" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
        </StackPanel>
    </DockPanel>
</Window>
