<Window x:Class="SessionApp.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        ShowActivated="False"
        MinWidth="160" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource Brush.Popup.Background}"
            BorderBrush="{DynamicResource Brush.Control.Border}"
            BorderThickness="1" CornerRadius="4" Padding="3">
        <StackPanel>
            <Button Content="Open Sky" Style="{DynamicResource MenuRow}" Click="Open_Click"/>
            <Button Content="Exit" Style="{DynamicResource MenuRow}" Click="Exit_Click"/>
        </StackPanel>
    </Border>
</Window>
